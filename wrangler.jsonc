{
  "name": "cherny-vestnik",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": {"crons": ["* * * * *"]},
  "vars": {
    "GROQ_MODEL": "qwen/qwen3.8-27b",
    "BOT_TIME_ZONE": "Europe/Moscow",
    "GROQ_DAILY_TOKEN_SOFT_LIMIT": "180000",
    "GROQ_TOKEN_RESERVE": "3500"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cherny-vestnik",
    "database_id": "REPLACE_WITH_D1_DATABASE_UUID",
    "migrations_dir": "migrations"
  }]
}